<Window x:Class="GuoBuZiLiaoGuanLi.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日期统计" Height="700" Width="1000"
        Background="#F5F7FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📊 按日期统计" FontSize="22" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,16" />

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="查询方式:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14" Foreground="#4A5568" />

                    <RadioButton x:Name="SingleDayRadio" Grid.Column="1" Content="单日查询" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14" Checked="QueryMode_Checked" />
                    <RadioButton x:Name="RangeRadio" Grid.Column="2" Content="日期范围查询" VerticalAlignment="Center" FontSize="14" Checked="QueryMode_Checked" />
                </Grid>

                <Grid x:Name="SingleDatePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="选择日期:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#4A5568" />
                    <DatePicker x:Name="SingleDatePicker" Grid.Column="1" VerticalAlignment="Center" FontSize="14" />
                    <Button x:Name="QuerySingleButton" Grid.Column="3" Content="🔍 查询" Background="#17A2B8" Padding="20,8" Click="QuerySingleButton_Click" />
                </Grid>

                <Grid x:Name="RangeDatePanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="开始日期:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#4A5568" />
                    <DatePicker x:Name="StartDatePicker" Grid.Column="1" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="结束日期:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#4A5568" />
                    <DatePicker x:Name="EndDatePicker" Grid.Column="3" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0" />
                    <Button x:Name="QueryRangeButton" Grid.Column="5" Content="🔍 查询" Background="#17A2B8" Padding="20,8" Click="QueryRangeButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="总份数" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TotalCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="已上传" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" />
                            <TextBlock x:Name="UploadedCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#DBEAFE" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="未上传" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NotUploadedCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#FEE2E2" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="缺资料/暂滞" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" />
                            <TextBlock x:Name="MissingCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ResultPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ExportButton" Content="📊 导出统计结果" Background="#28A745" Padding="20,10" Click="ExportButton_Click" Margin="0,0,8,0" Visibility="Collapsed" />
            <Button x:Name="CloseButton" Content="关闭" Background="#6C757D" Padding="24,10" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
