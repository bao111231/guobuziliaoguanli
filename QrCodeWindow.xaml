<Window x:Class="GuoBuZiLiaoGuanLi.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机扫码下载" Height="650" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📱 扫码下载到手机" FontSize="22" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="请确保手机与电脑连接同一WiFi" FontSize="13" Foreground="#718096" HorizontalAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center" />

                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Image x:Name="QrCodeImage" Width="260" Height="260" Stretch="Uniform" />
                </Border>

                <Border Background="#EBF5FF" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="访问地址" FontSize="11" Foreground="#6C757D" HorizontalAlignment="Center" />
                        <TextBlock x:Name="UrlText" FontSize="15" FontWeight="SemiBold" Foreground="#0056B3" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" Cursor="Hand" MouseLeftButtonUp="UrlText_MouseLeftButtonUp" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button x:Name="CopyUrlButton" Content="📋 复制链接" Background="#6C757D" Foreground="White" Margin="0,0,8,0" Padding="16,10" Click="CopyUrlButton_Click" />
                    <Button x:Name="TestBrowserButton" Content="🌐 本机测试" Background="#17A2B8" Foreground="White" Margin="0,0,8,0" Padding="16,10" Click="TestBrowserButton_Click" />
                    <Button x:Name="CloseButton" Content="关闭" Background="#DC3545" Foreground="White" Padding="16,10" Click="CloseButton_Click" />
                </StackPanel>

                <Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#DEE2E6" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔍 诊断信息" FontSize="12" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,6" />
                        <ItemsControl x:Name="DiagnosticList" FontSize="11" Foreground="#6C757D">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#FFF3CD" CornerRadius="8" Padding="10" BorderBrush="#FFEAA7" BorderThickness="1">
                    <TextBlock FontSize="11" Foreground="#856404" TextWrapping="Wrap" Text="如果手机无法访问，请检查：1.手机和电脑是否在同一WiFi；2.电脑防火墙是否拦截；3.可手动在浏览器输入地址访问" />
                </Border>

                <TextBlock x:Name="StatusText" FontSize="12" Foreground="#28A745" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
