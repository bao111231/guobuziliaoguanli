<Window x:Class="GuoBuZiLiaoGuanLi.TempStorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资料暂存" Height="700" Width="1100"
        Background="#F5F7FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="📦 资料暂存" FontSize="22" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,4" />
                <TextBlock Text="拖拽文件到下方区域暂存，可修改文件名，需要时从暂存导入到客户文件夹" FontSize="13" Foreground="#718096" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Content="📷 扫描添加" Background="#28A745" Margin="0,0,8,0" Padding="16,8" Click="ScanButton_Click" />
                <Button x:Name="AddFilesButton" Content="📁 添加文件" Background="#17A2B8" Margin="0,0,8,0" Padding="16,8" Click="AddFilesButton_Click" />
                <Button x:Name="OpenFolderButton" Content="📂 打开文件夹" Background="#6C757D" Margin="0,0,8,0" Padding="16,8" Click="OpenFolderButton_Click" />
                <Button x:Name="ClearAllButton" Content="🗑️ 清空全部" Background="#DC3545" Padding="16,8" Click="ClearAllButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FileListPanel" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" x:Name="FileCountText" FontSize="12" Foreground="#718096" Margin="0,8,0,0" Text="共 0 个文件" />
                </Grid>
            </Border>

            <Border Grid.Column="2" x:Name="DropBorder" Background="#F7FAFC" CornerRadius="12"
                    AllowDrop="True"
                    PreviewDragEnter="DropBorder_PreviewDragOver"
                    PreviewDragOver="DropBorder_PreviewDragOver"
                    PreviewDrop="DropBorder_PreviewDrop"
                    PreviewDragLeave="DropBorder_PreviewDragLeave">
                <Grid>
                    <Grid x:Name="DropHint" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="64" HorizontalAlignment="Center" Foreground="#CBD5E0" />
                            <TextBlock Text="拖拽文件到这里暂存" FontSize="18" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="支持: jpg, png, bmp, gif, tiff, pdf" FontSize="13" Foreground="#CBD5E0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PreviewPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#EDF2F7" CornerRadius="8" Margin="16">
                            <ContentControl x:Name="PreviewContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="16,0,16,16" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748" TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文件名:" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="RemarkTextBox" Grid.Column="1" FontSize="13" Padding="8"
                                             LostFocus="RemarkTextBox_LostFocus"
                                             KeyDown="RemarkTextBox_KeyDown"
                                             AcceptsReturn="False" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="DeleteFileButton" Content="🗑️ 删除此文件" Background="#DC3545" Padding="16,8" Click="DeleteFileButton_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="关闭" Background="#6C757D" Padding="24,10" Click="CloseButton_Click" Margin="0,0,8,0" />
        </StackPanel>
    </Grid>
</Window>
