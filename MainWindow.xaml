<Window x:Class="GuoBuZiLiaoGuanLi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="国补资料管理系统" Height="850" Width="1280"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FilterRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#F1F5F9" CornerRadius="14" Padding="8,4" BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="indicator" Width="14" Height="14" Fill="#CBD5E0" Stroke="White" StrokeThickness="1" />
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EDF2F7" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0AEC0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="客户文件夹" FontSize="20" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,8" />
                    <TextBlock x:Name="StatusSummaryText" FontSize="13" Foreground="#718096" TextWrapping="Wrap" Margin="0,0,0,12" />
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button x:Name="SelectFolderButton" Content="📁 选择根目录" Background="#6C757D" Margin="0,0,4,4" Padding="10,6" Click="SelectFolderButton_Click" />
                    <Button x:Name="RefreshButton" Content="🔄 刷新" Background="#17A2B8" Margin="0,0,4,4" Padding="10,6" Click="RefreshButton_Click" />
                    <Button x:Name="PhoneTransferButton" Content="📱 手机传输" Background="#6F42C1" Margin="0,0,4,4" Padding="10,6" Click="PhoneTransferButton_Click" />
                    <Button x:Name="TempStorageButton" Content="📦 暂存" Background="#0D9488" Margin="0,0,4,4" Padding="10,6" Click="TempStorageButton_Click" />
                    <Button x:Name="StatisticsButton" Content="📊 统计" Background="#EA580C" Margin="0,0,4,4" Padding="10,6" Click="StatisticsButton_Click" />
                </WrapPanel>

                <TextBlock Grid.Row="2" Text="筛选状态:" FontSize="13" Foreground="#4A5568" Margin="0,0,0,8" />

                <WrapPanel Grid.Row="3" Margin="0,0,0,12">
                    <RadioButton x:Name="FilterAll" IsChecked="True" Style="{StaticResource FilterRadioButtonStyle}" Checked="Filter_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Fill="#6C757D" Stroke="White" StrokeThickness="1" />
                            <TextBlock Text="全部" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterMissing" Style="{StaticResource FilterRadioButtonStyle}" Checked="Filter_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Fill="#DC3545" Stroke="White" StrokeThickness="1" />
                            <TextBlock Text="缺资料" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterPending" Style="{StaticResource FilterRadioButtonStyle}" Checked="Filter_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Fill="#6F42C1" Stroke="White" StrokeThickness="1" />
                            <TextBlock Text="暂滞" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterNotUploaded" Style="{StaticResource FilterRadioButtonStyle}" Checked="Filter_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Fill="#007BFF" Stroke="White" StrokeThickness="1" />
                            <TextBlock Text="未上传" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterUploadedUnconfirmed" Style="{StaticResource FilterRadioButtonStyle}" Checked="Filter_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Fill="#FF9800" Stroke="White" StrokeThickness="1" />
                            <TextBlock Text="未确认" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterUploaded" Style="{StaticResource FilterRadioButtonStyle}" Checked="Filter_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Fill="#28A745" Stroke="White" StrokeThickness="1" />
                            <TextBlock Text="已上传" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>

                <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 TextChanged="SearchBox_TextChanged"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 CaretBrush="#4A5568" Foreground="#2D3748">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="0" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索客户姓名/日期..." 
                                   FontSize="14" Foreground="#A0AEC0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="2,0,0,0" />
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" FontSize="12"
                                Background="Transparent" BorderThickness="0" Foreground="#A0AEC0"
                                Padding="4" VerticalAlignment="Center" Cursor="Hand"
                                Click="ClearSearchButton_Click" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="5" x:Name="OrderByHint" FontSize="12" Foreground="#A0AEC0" Margin="0,0,0,6" Text="按日期排序，最新在前" />

                <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FolderListPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" x:Name="DetailPanel" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FolderDateText" FontSize="14" Foreground="#0D9488" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="FolderNameText" FontSize="22" FontWeight="Bold" Foreground="#2D3748" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="StatusBadge" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="CreationTimeText" FontSize="12" Foreground="#718096" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MarkCompleteButton" Content="✓ 标记资料齐全" Background="#007BFF" Margin="0,0,8,0" Click="MarkCompleteButton_Click" Visibility="Collapsed" Padding="12,8" FontSize="12" />
                        <Button x:Name="UnmarkCompleteButton" Content="✕ 取消资料齐全" Background="#6C757D" Margin="0,0,8,0" Click="UnmarkCompleteButton_Click" Visibility="Collapsed" Padding="12,8" FontSize="12" />
                        <Button x:Name="MarkPendingButton" Content="⏸ 标记暂滞" Background="#6F42C1" Margin="0,0,8,0" Click="MarkPendingButton_Click" Visibility="Collapsed" Padding="12,8" FontSize="12" />
                        <Button x:Name="UnmarkPendingButton" Content="▶ 取消暂滞" Background="#E83E8C" Margin="0,0,8,0" Click="UnmarkPendingButton_Click" Visibility="Collapsed" Padding="12,8" FontSize="12" />
                        <Button x:Name="MarkUploadedButton" Content="✓ 标记已上传" Background="#28A745" Margin="0,0,8,0" Click="MarkUploadedButton_Click" Visibility="Collapsed" Padding="12,8" FontSize="12" />
                        <Button x:Name="UnmarkUploadedButton" Content="↩ 取消已上传" Background="#FFC107" Click="UnmarkUploadedButton_Click" Visibility="Collapsed" Padding="12,8" FontSize="12" />
                        <Button x:Name="OpenFolderButton" Content="📂 打开文件夹" Background="#6C757D" Margin="8,0,0,0" Click="OpenFolderButton_Click" Padding="12,8" FontSize="12" />
                        <Button x:Name="DeleteFolderButton" Content="🗑️" Background="#DC3545" Margin="8,0,0,0" Click="DeleteFolderButton_Click" Padding="12,8" FontSize="12" ToolTip="删除文件夹" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="📋 所需资料（点击选择后可拖拽或从暂存导入）" FontSize="16" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,20,0,12" />

                <StackPanel Grid.Row="2" x:Name="DocumentItemsPanel" Margin="0,0,0,16" />

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🖼️ 图片预览" FontSize="16" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,12" />

                    <Grid x:Name="PreviewDropGrid" Grid.Row="1" Background="#F7FAFC" AllowDrop="False"
                          PreviewDragEnter="PreviewDropGrid_PreviewDragEnter"
                          PreviewDragOver="PreviewDropGrid_PreviewDragOver"
                          PreviewDrop="PreviewDropGrid_PreviewDrop"
                          PreviewDragLeave="PreviewDropGrid_PreviewDragLeave">
                        <Border x:Name="PreviewAreaBorder" Background="Transparent" CornerRadius="8" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Focusable="False">
                                <WrapPanel x:Name="PreviewPanel" Orientation="Horizontal" Background="Transparent" />
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="NoPreviewText" Background="Transparent" CornerRadius="8" Padding="16">
                            <TextBlock x:Name="NoPreviewTextBlock" Text="请先点击选择左侧资料项，然后拖拽图片文件到这里导入，或点击导入按钮从暂存选择" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0AEC0" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2" x:Name="WelcomePanel" Background="White" CornerRadius="12" Padding="40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📁 国补资料管理系统" FontSize="28" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="请点击左上角「选择根目录」按钮，选择包含客户文件夹的目录开始管理资料。"
                           FontSize="15" Foreground="#718096" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" MaxWidth="400" />
                <Button x:Name="WelcomeSelectFolderButton" Content="📁 选择根目录"
                        HorizontalAlignment="Center" Margin="0,24,0,0" Padding="24,12" FontSize="16"
                        Click="SelectFolderButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="📦 资料暂存" Background="#0D9488" Margin="4,0" Padding="16,8" Click="TempStorageButton_Click" />
                    <Button Content="📊 日期统计" Background="#EA580C" Margin="4,0" Padding="16,8" Click="StatisticsButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
